[Unit]
Description=ShadowLink Secure Tunnel Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shadowlink
Group=shadowlink
WorkingDirectory=/opt/shadowlink
ExecStart=/opt/shadowlink/shadowlink-server /etc/shadowlink/config.toml
Restart=always
RestartSec=5
LimitNOFILE=65535
EnvironmentFile=/etc/shadowlink/env
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=no
ReadWritePaths=/etc/shadowlink /var/log/shadowlink /run/shadowlink
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
